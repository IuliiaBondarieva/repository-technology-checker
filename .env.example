# ============================================================================
# Tech Stack Checker — environment variables
# Copy this file to `.env.local` (gitignored) and fill in what you need.
# Everything here is OPTIONAL: the tool runs fully offline by default.
# ============================================================================

# ---- GitHub (optional) --------------------------------------------------- #
# Increases the API rate limit and is required for private repositories.
# Create one at https://github.com/settings/tokens (no scopes needed for
# public repos; `repo` scope for private).
# GITHUB_TOKEN=ghp_...

# ---- AI tie-breaker (optional) ------------------------------------------- #
# Only needed if you pass `--use-ai` to the CLI or check the AI box in the UI.
# Used purely to match unresolved detected items against BROAD allowed-list
# entries like "JavaScript testing tools" or "anything in the Spring family".
# Any OpenAI-compatible endpoint works.

# Option A: OpenAI cloud (paid)
# OPENAI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini

# Option B: Ollama (local, free)
#   brew install ollama && brew services start ollama
#   ollama pull qwen2.5:7b
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# AI_MODEL=qwen2.5:7b

# Option C: Other OpenAI-compatible providers
# Groq:       OPENAI_BASE_URL=https://api.groq.com/openai/v1
# Together:   OPENAI_BASE_URL=https://api.together.xyz/v1
# OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1
